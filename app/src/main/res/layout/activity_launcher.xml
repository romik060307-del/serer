<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper">

    <ImageView
        android:id="@+id/wallpaperImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Wallpaper pilihan"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="74dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="9:41"
                    android:textColor="#FFFFFFFF"
                    android:textSize="38sp" />
                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senin, 20 Oktober"
                    android:textColor="#D9E9FA"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/notificationsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_small"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/controlButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_small"
                    android:gravity="center"
                    android:text="☷"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_small"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:contentDescription="Pengaturan launcher" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/islandButton"
                android:layout_width="102dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_island"
                android:gravity="center"
                android:text="●  RK GLASS"
                android:textColor="#C6E4FF"
                android:textSize="9sp"
                android:letterSpacing="0.08" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widgetCard"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELAMAT DATANG"
                    android:textColor="#BBDFFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.16" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Liquid Glass, versi ringan"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widgetSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Geser ke atas untuk semua aplikasi"
                    android:textColor="#D0E4F7"
                    android:textSize="10sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/weatherButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_glass_small"
                android:gravity="center"
                android:text="☼"
                android:textColor="#FFE8A3"
                android:textSize="29sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/homeGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="4"
            android:rowCount="4"
            android:useDefaultMargins="false" />

        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="●   ○"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_glass"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/homeIndicator"
            android:layout_width="88dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_island" />
    </LinearLayout>
</FrameLayout>
